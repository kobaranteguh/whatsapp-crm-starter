# Portal → Integration  (https://partner.wasapflow.com/bridge/partner/integration)
WASAPFLOW_PARTNER_KEY=wf_live_your_partner_key
WASAPFLOW_WEBHOOK_SECRET=whsec_your_webhook_secret

# Optional
WASAPFLOW_BASE_URL=https://officialapi.wasapflow.com/bridge/v1
PORT=3000

# Protects the inbox UI and /api/* with HTTP Basic auth (user: admin).
# The webhook endpoint is protected by the signature instead. Leave empty only on localhost.
ADMIN_PASSWORD=change-me
